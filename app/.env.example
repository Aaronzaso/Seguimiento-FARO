# Secretos privados de la Vercel Function. Configurarlos en Vercel; no poner
# valores reales en este archivo ni usar prefijos VITE_ para estas variables.
GITHUB_TOKEN=
# JSON sensible generado con `npm run generate-users`. Cada integrante recibe
# una clave distinta; el servidor deriva de ella el nombre registrado.
FARO_USERS_JSON=
FARO_SESSION_SECRET=
# Opcional: origen canónico. Si se omite, se valida contra el host de la petición.
FARO_ALLOWED_ORIGIN=

# Compatibilidad transitoria con la clave compartida anterior. Se ignora cuando
# FARO_USERS_JSON existe y solo se habilita con el flag explícito.
FARO_SAVE_TOKEN=
FARO_ALLOW_SHARED_TOKEN=false

# Configuración no secreta del repositorio de cortes.
GITHUB_REPOSITORY=Aaronzaso/Seguimiento-FARO
GITHUB_BRANCH=main

# Opcionales: identidad que aparecerá en los commits automáticos.
GITHUB_COMMITTER_NAME=FARO Seguimiento
GITHUB_COMMITTER_EMAIL=
